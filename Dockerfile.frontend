# Build stage
FROM node:18-alpine AS build

WORKDIR /app

# Copy package files and install dependencies
COPY service/frontend/package*.json ./
RUN npm install

# Copy the rest of the frontend code
COPY service/frontend/ ./

# Build the application
# We use build-time variables if needed
RUN npm run build

# Production stage
FROM nginx:stable-alpine

# Copy build artifacts from build stage
COPY --from=build /app/dist /usr/share/nginx/html

# Copy custom nginx config if exists, otherwise use default
# COPY service/frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
